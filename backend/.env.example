# Meta Muse Spark 1.3 Contributor (OpenAI-compatible Chat Completions). Leave empty to disable /v1/plan.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3-contributor

# SQLite database (WAL). The directory is created on startup.
ADJUTANT_DB_PATH=./data/adjutant.db

# HMAC-SHA256 key for audit packets. REQUIRED in production (a dev key is used, with a warning, if unset).
ADJUTANT_SIGNING_KEY=

# Comma-separated CORS origins; "*" for local dev.
# Production: https://adjutant.spacesdrive.cc,https://adjutant.pages.dev,http://localhost:5173
ALLOWED_ORIGINS=*

# Build / deploy metadata surfaced by GET /health
GIT_SHA=
DEPLOYED_AT=
APP_ENV=development
