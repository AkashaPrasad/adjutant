# Base URL of the Adjutant Gate API (no trailing slash).
VITE_API_BASE=http://localhost:8000

# Injected at build time by CI so the console can show which commit is live.
# e.g. VITE_GIT_SHA=$(git rev-parse HEAD) VITE_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) npm run build
VITE_GIT_SHA=dev
VITE_BUILD_TIME=
